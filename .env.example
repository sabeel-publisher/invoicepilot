# Copy to .env and fill in to switch from the built-in PayPal simulator
# to the real PayPal Sandbox API (free developer account at developer.paypal.com).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Optional: enables the LLM invoice parser (falls back to the built-in parser otherwise)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

PORT=3000
